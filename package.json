{
  "name": "openfix",
  "version": "0.1.0",
  "description": "Test-Driven Bug Fixing (TDBF) & Root Cause Analysis (RCA) framework for engineers and AI coding assistants",
  "type": "module",
  "bin": {
    "openfix": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openfix",
    "openspec",
    "bug-fixing",
    "tdbf",
    "rca",
    "root-cause-analysis",
    "triage",
    "ai-agents",
    "jira"
  ],
  "author": "OpenFix Contributors",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
